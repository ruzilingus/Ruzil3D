<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net35 — для старых версий Unity и .NET Framework, netstandard2.0 — для Unity 2018+, .NET Core и .NET 5+. -->
    <TargetFrameworks>net35;netstandard2.0</TargetFrameworks>
    <RootNamespace>Ruzil3D</RootNamespace>
    <AssemblyName>Ruzil3D</AssemblyName>
    <LangVersion>6</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);Ruzil3D.Tests/**;Ruzil3D.Tests.NetFramework/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Метаданные пакета NuGet (dotnet pack). Версия совпадает с AssemblyVersion в Properties/AssemblyInfo.cs. -->
    <PackageId>Ruzil3D</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ruzil</Authors>
    <Description>Библиотека математики для разработчиков игр: дроби, комплексные числа, многочлены, векторы, матрицы, кватернионы, геометрия на плоскости и в пространстве, кривые Безье, численное интегрирование, интерполяция и сглаживание.</Description>
    <Copyright>Copyright © 2015</Copyright>
    <PackageTags>math;geometry;3d;vector;matrix;quaternion;polynomial;fraction;bezier;numerical;unity</PackageTags>
    <PackageProjectUrl>https://github.com/ruzilingus/Ruzil3D</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ruzilingus/Ruzil3D</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net35'">
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Позволяет собирать net35 без установленного targeting pack, в том числе на Linux и macOS. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
